FROM node:20-alpine

WORKDIR /app

# Copy root package files if any (monorepo style) or just server
COPY package*.json ./
COPY server/package*.json ./server/

# Install server dependencies
WORKDIR /app/server
# Install system dependencies (Poppler for PDF, Build tools for SQLite/Native modules)
RUN apk update && apk add --no-cache \
    poppler-utils \
    python3 \
    make \
    g++

RUN npm install

# Copy source code
WORKDIR /app
# Create data directories at ROOT (where constants.js expects them)
# Create data directories at ROOT (where constants.js expects them)
RUN mkdir -p /app/data /app/uploads /app/audit_results && chown -R node:node /app/data /app/uploads /app/audit_results && chmod -R 777 /app/data /app/uploads /app/audit_results

# Copy source code
COPY server ./server
COPY scripts ./scripts


# Expose API Port
EXPOSE 3000

# Start Server
# Start Server from ROOT (where package.json scripts expect to run)
# Start Server
# Start Server from ROOT (where package.json scripts expect to run)
WORKDIR /app
USER node
CMD ["npm", "start"]
