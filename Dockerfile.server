FROM node:18-alpine

WORKDIR /app

# Copy root package files if any (monorepo style) or just server
COPY package*.json ./
COPY server/package*.json ./server/

# Install server dependencies
WORKDIR /app/server
RUN npm install

# Copy source code
WORKDIR /app
# Create data directories (instead of copying, as they might be ignored by git)
RUN mkdir -p uploads audit_results server/src/data

# Copy source code
COPY server ./server
COPY scripts ./scripts


# Expose API Port
EXPOSE 3000

# Start Server
WORKDIR /app/server
CMD ["npm", "start"]
