{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Canonical Document Schema",
    "type": "object",
    "properties": {
        "docType": {
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "invoice",
                "proforma",
                "credit_note",
                "order_confirmation",
                "offer",
                "receipt",
                "other",
                null
            ]
        },
        "docNumber": {
            "type": [
                "string",
                "null"
            ]
        },
        "currency": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "^[A-Z]{3}$"
        },
        "dates": {
            "type": "object",
            "properties": {
                "issued": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                },
                "due": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date"
                }
            },
            "additionalProperties": false
        },
        "entities": {
            "type": "object",
            "properties": {
                "supplier": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "vat": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "address": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                },
                "customer": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "vat": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "address": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "totals": {
            "type": "object",
            "properties": {
                "goods": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "transport": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "packaging": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "discount": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "subtotal": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "tax": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "total": {
                    "type": [
                        "number",
                        "null"
                    ]
                }
            },
            "additionalProperties": false
        },
        "lines": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "quantity": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "unitPrice": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "discount": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "vatRate": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "total": {
                        "type": [
                            "number",
                            "null"
                        ]
                    }
                }
            }
        },
        "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "needsReview": {
            "type": "boolean"
        },
        "reviewReason": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "docType",
        "confidence",
        "needsReview"
    ]
}